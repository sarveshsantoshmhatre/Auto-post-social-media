APP_NAME=AutoPost AI
DATABASE_URL=sqlite+aiosqlite:///./autopost.db
APP_BASE_URL=http://localhost:8000

# LLM / content generation
OPENAI_API_KEY=

# Optional news/trend provider keys
GNEWS_API_KEY=
NEWSAPI_API_KEY=

# TTS / media providers
ELEVENLABS_API_KEY=

# Social platform credentials are added only after the relevant app is created
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# Publishing behavior
AUTO_PUBLISH_ENABLED=false
REQUIRE_APPROVAL=true
DEFAULT_TIMEZONE=Asia/Kolkata
